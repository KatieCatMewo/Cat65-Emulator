<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox id="root" spacing="5" prefHeight="550.0" prefWidth="700.0"
      xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1">
    <stylesheets>
        <URL value="@../../css/style.css" />
        <URL value="@../../css/serial-terminal.css" />
    </stylesheets>
    <MenuBar VBox.vgrow="NEVER">
        <Menu mnemonicParsing="false" text="Terminal">
            <MenuItem mnemonicParsing="false" text="Clear" onAction="#clear" />
            <SeparatorMenuItem mnemonicParsing="false" />
            <MenuItem mnemonicParsing="false" text="Preferences" onAction="#openSerialConfig" />
        </Menu>
        <Menu mnemonicParsing="false" text="Help">
            <MenuItem mnemonicParsing="false" text="Help" />
        </Menu>
    </MenuBar>
    <VBox styleClass="container" spacing="5" VBox.vgrow="ALWAYS">
        <TextArea id="terminal" fx:id="terminal" editable="false" onKeyTyped="#onKeyTyped" styleClass="screen" wrapText="true" VBox.vgrow="ALWAYS" />
    </VBox>
</VBox>
