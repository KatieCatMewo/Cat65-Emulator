<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox id="root" prefHeight="350.0" prefWidth="500.0" spacing="5" stylesheets="@../../css/style.css"
      xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1">
    <HBox styleClass="box">
        <ComboBox fx:id="cbx_debugMode" prefWidth="150.0" />
    </HBox>
    <HBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" styleClass="box" VBox.vgrow="ALWAYS">
        <Slider fx:id="slider_scale" blockIncrement="0.05" majorTickUnit="0.1" max="1.0" min="0.1"
                minorTickCount="1" orientation="VERTICAL" showTickLabels="true" showTickMarks="true" value="1.0" />
        <VBox fx:id="container" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
    </HBox>
</VBox>
